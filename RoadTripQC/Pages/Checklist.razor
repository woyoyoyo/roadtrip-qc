@page "/checklist"
@implements IDisposable
@inject TripStore Store

<PageTitle>RoadTrip QC — Checklist</PageTitle>

<header class="page-header">
    <h1>✅ Checklist</h1>
</header>

@if (Store.Data is null)
{
    <div class="loading-message">Chargement…</div>
}
else if (Store.Data.Checklist.Count == 0)
{
    <div class="empty-message">Rien dans la checklist 🎉</div>
}
else
{
    @if (_error is not null)
    {
        <div class="sync-status sync-warn">⚠️ @_error</div>
    }
    @if (Store.Source == DataSource.Demo)
    {
        <div class="sync-status sync-demo">🧪 Mode démo — les coches ne sont pas sauvegardées.</div>
    }

    @foreach (var group in GroupedItems)
    {
        <h2 class="checklist-group">@PriorityLabel(group.Key)</h2>
        @foreach (var item in group)
        {
            <label class="checklist-item @(item.Done ? "is-done" : "") @(_busyId == item.Id ? "is-busy" : "")">
                <input type="checkbox" checked="@item.Done" disabled="@(_busyId is not null)"
                       @onchange="e => ToggleAsync(item, e)" />
                <span class="checklist-text">@item.Task</span>
                @if (!string.IsNullOrWhiteSpace(item.Url))
                {
                    <a class="action-btn btn-web checklist-link" href="@item.Url" target="_blank" rel="noopener">🌐</a>
                }
            </label>
        }
    }
}

@code {
    private static readonly string[] PriorityOrder = ["haute", "moyenne", "basse"];

    private string? _error;
    private string? _busyId;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureLoadedAsync();
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<IGrouping<string, ChecklistItem>> GroupedItems =>
        Store.Data!.Checklist
            .OrderBy(i => Array.IndexOf(PriorityOrder, i.Priority))
            .GroupBy(i => i.Priority);

    private static string PriorityLabel(string priority) => priority switch
    {
        "haute" => "🚨 Priorité haute",
        "moyenne" => "🔸 Priorité moyenne",
        _ => "🔹 Un jour peut-être"
    };

    private async Task ToggleAsync(ChecklistItem item, ChangeEventArgs e)
    {
        var done = e.Value is true;
        _error = null;

        // Mode démo : coche locale, sans sauvegarde.
        if (Store.Source == DataSource.Demo)
        {
            item.Done = done;
            return;
        }

        _busyId = item.Id;
        var (ok, error) = await Store.SaveAsync(data =>
        {
            var target = data.Checklist.FirstOrDefault(c => c.Id == item.Id);
            if (target is null)
                return false;
            target.Done = done;
            return true;
        });
        _busyId = null;

        if (!ok)
            _error = error;
    }
}
