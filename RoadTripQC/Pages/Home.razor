@page "/"
@implements IDisposable
@inject TripStore Store
@inject IJSRuntime JS

<PageTitle>RoadTrip QC — Planning</PageTitle>

@if (Store.Data is null)
{
    @if (Store.LoadError is not null)
    {
        <div class="load-error">
            <p>⚠️ Impossible de charger le planning.</p>
            <p class="error-detail">@Store.LoadError</p>
            <button class="action-btn btn-refresh" @onclick="ReloadAsync">🔄 Réessayer</button>
        </div>
    }
    else
    {
        <div class="loading-message">Chargement du planning…</div>
    }
}
else
{
    <header class="page-header">
        <h1>@Store.Data.Trip.Name</h1>
        <div class="trip-sub">
            @if (Store.OrderedDays.Count > 0)
            {
                <span>@FrenchDate.Range(Store.OrderedDays[0].Date, Store.OrderedDays[^1].Date)</span>
            }
        </div>
        @if (CountdownText is not null)
        {
            <div class="trip-countdown">@CountdownText</div>
        }

        @switch (Store.Source)
        {
            case DataSource.Gist:
                <div class="sync-status sync-ok">✅ Synchronisé @SyncTime</div>
                break;
            case DataSource.Cache:
                <div class="sync-status sync-offline">📵 Hors ligne — données synchronisées @SyncTime</div>
                break;
            case DataSource.Demo:
                <div class="sync-status sync-demo">🧪 Données de démo — <a href="parametres">configurer l'app</a></div>
                break;
        }
        @if (Store.LoadError is not null && Store.Data is not null)
        {
            <div class="sync-status sync-warn">⚠️ @Store.LoadError</div>
        }

        <div class="header-actions no-print">
            <button class="action-btn btn-refresh" @onclick="ReloadAsync" disabled="@_reloading">
                @(_reloading ? "⏳ Actualisation…" : "🔄 Actualiser")
            </button>
            <button class="action-btn btn-print" @onclick="PrintAsync" title="Exporter en PDF">🖨️ PDF</button>
        </div>
    </header>

    @foreach (var part in Store.Data!.Parts.OrderBy(p => p.DateStart))
    {
        <div class="part-banner part-@part.Id">
            <span class="part-emoji">@part.Emoji</span>
            <div class="part-text">
                <span class="part-title">@part.Title</span>
                <span class="part-dates">@FrenchDate.Range(part.DateStart, part.DateEnd)</span>
            </div>
        </div>

        @foreach (var day in Store.OrderedDays.Where(d => d.PartId == part.Id))
        {
            <DaySection Day="day" DayNumber="Store.DayNumber(day)" />
        }
    }
}

@code {
    private bool _reloading;

    private string SyncTime =>
        Store.LastSync is { } d ? $"le {d:dd/MM} à {d:HH\\hmm}" : "";

    private string? CountdownText
    {
        get
        {
            if (Store.OrderedDays.Count == 0) return null;
            var today = DateOnly.FromDateTime(DateTime.Now);
            var departure = Store.OrderedDays[0].Date;
            var returnDate = Store.OrderedDays[^1].Date;

            if (today < departure)
            {
                var days = departure.DayNumber - today.DayNumber;
                return days == 1 ? "Départ demain 🛫" : $"J-{days} avant le départ 🛫";
            }
            if (today <= returnDate)
            {
                var day = today.DayNumber - departure.DayNumber + 1;
                var total = returnDate.DayNumber - departure.DayNumber + 1;
                var left = returnDate.DayNumber - today.DayNumber;
                return left == 0
                    ? $"Jour {day}/{total} — dernier jour 🍁"
                    : $"Jour {day}/{total} — encore {left} jour{(left > 1 ? "s" : "")} 🍁";
            }
            return "Voyage terminé — à bientôt ! 🍁";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureLoadedAsync();
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _reloading = true;
        await Store.ReloadAsync();
        _reloading = false;
    }

    private async Task PrintAsync() =>
        await JS.InvokeVoidAsync("roadtrip.printPlan");
}
